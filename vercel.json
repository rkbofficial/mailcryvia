{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server/**"]
      }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/unsubscribe/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
