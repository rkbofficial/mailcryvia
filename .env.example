# Root template for local/static config.
# Use the Vercel project settings for the real production values.
NODE_ENV=production
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
ENCRYPTION_KEY=<generate-64-hex-characters>
INITIAL_ADMIN_SETUP_TOKEN=<generate-a-random-secret-at-least-32-characters>
APP_BASE_URL=https://mailcryvia.vercel.app
DATABASE_URL=postgresql://username:password@host:5432/database_name
CORS_ORIGIN=https://mailcryvia.vercel.app
CRON_SECRET=<generate-a-random-secret-at-least-32-characters>

# Copy server/.env.example to server/.env for backend runtime.
# Copy playwright-test/.env.example to playwright-test/.env for local screenshot scripts.
