PORT=4000
NODE_ENV=production
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
ENCRYPTION_KEY=<generate-64-hex-characters>
INITIAL_ADMIN_SETUP_TOKEN=<generate-a-random-secret-at-least-32-characters>
APP_BASE_URL=https://your-production-domain.example
DATABASE_PATH=/opt/data/database.sqlite
CORS_ORIGIN=https://your-production-domain.example

# Optional Razorpay payment processing. Leave blank to disable online payments.
RAZORPAY_KEY_ID=<razorpay-key-id-or-blank>
RAZORPAY_KEY_SECRET=<razorpay-key-secret-or-blank>

# Optional: only use true during local SMTP troubleshooting, never in production.
SMTP_ALLOW_INVALID_TLS=false